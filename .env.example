# Copy to .env and fill in. Never commit .env or real keys.

# Hex private key WITHOUT 0x prefix (or with — Foundry accepts both)
PRIVATE_KEY=

# RPC
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Optional Basescan key for verify
BASESCAN_API_KEY=

# Deploy options:
# Leave USDC_ADDRESS empty on anvil to deploy MockUSDC
# Base Sepolia USDC (Circle): set when deploying to Sepolia — check current address
# Base mainnet USDC: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913  (DO NOT spend in demos)
USDC_ADDRESS=
MINT_DEMO=true

# After deploy, paste into web UI / localStorage:
# CONTRACT_ADDRESS=
